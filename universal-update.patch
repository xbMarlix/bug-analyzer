new file mode 100644
index 0000000..00babb8
--- /dev/null
+++ b/bug_hunter/rules/go.yaml
@@ -0,0 +1,80 @@
+# Pattern rules for Go.
+- id: go-exec-command
+  pattern: 'exec\.Command\s*\([^)]*"sh"\s*,\s*"-c"'
+  severity: high
+  category: injection
+  title: exec.Command with sh -c
+  description: sh -c with interpolated strings is command injection.
+  suggestion: Pass the binary and args directly to exec.Command.
+
+- id: go-sql-fmt
+  pattern: 'fmt\.Sprintf\s*\(\s*"[^"]*(SELECT|INSERT|UPDATE|DELETE|WHERE)'
+  severity: high
+  category: sqli
+  title: SQL built with fmt.Sprintf
+  description: Sprintf into SQL is SQL injection.
+  suggestion: Use database/sql placeholders ($1, ?).
+
+- id: go-hardcoded-secret
+  pattern: '(?i)(apiKey|secret|password|token)\s*:?=\s*"[^"]{8,}"'
+  severity: high
+  category: secrets
+  title: Hardcoded credential
+  description: A secret/password/token is hardcoded in source.
+  suggestion: Load from environment or a secrets store.
+
+- id: go-tls-insecure
+  pattern: 'InsecureSkipVerify\s*:\s*true'
+  severity: high
+  category: crypto
+  title: TLS verification disabled
+  description: InsecureSkipVerify=true accepts any certificate — MITM.
+  suggestion: Remove it; configure proper RootCAs.
+
+- id: go-md5-password
+  pattern: 'md5\.(New|Sum)\s*\('
+  severity: medium
+  category: crypto
+  title: MD5 hash usage
+  description: MD5 is broken for security purposes (collisions, fast brute force).
+  suggestion: Use bcrypt/argon2 for passwords, SHA-256+ for integrity.
+
+- id: go-des-ofb
+  pattern: 'des\.(NewCipher|NewTripleDESCipher)'
+  severity: medium
+  category: crypto
+  title: DES/3DES cipher
+  description: DES and 3DES are deprecated and weak.
+  suggestion: Use AES-GCM.
+
+- id: go-ignore-error
+  pattern: '^\s*_\s*,?\s*\w*\s*=\s*\w+\.(Close|Write|Flush)\('
+  severity: low
+  category: error-handling
+  title: Error return ignored
+  description: Discarded error from a close/write can hide data loss.
+  suggestion: Check and handle the error.
+
+- id: go-goroutine-loop-var
+  pattern: 'go\s+func\s*\(\s*\)\s*\{[^}]*\b(range|for)\b'
+  severity: medium
+  category: race-condition
+  title: Goroutine capturing loop variable
+  description: Closures over loop variables can read the wrong value (pre-Go 1.22 semantics).
+  suggestion: Pass the variable as a parameter to the goroutine.
+
+- id: go-http-no-timeout
+  pattern: 'http\.(Get|Post|Head|Do)\s*\('
+  severity: medium
+  category: dos
+  title: HTTP request without timeout
+  description: Package-level http.Get uses the default client with no timeout — can hang forever.
+  suggestion: Use an http.Client with Timeout set.
+
+- id: go-yaml-unmarshal-untrusted
+  pattern: 'unsafe\.Pointer'
+  severity: medium
+  category: memory-safety
+  title: unsafe.Pointer usage
+  description: unsafe.Pointer bypasses Go's memory safety guarantees.
+  suggestion: Refactor to safe Go; if required, isolate and document.
diff --git a/bug_hunter/rules/javascript.yaml b/bug_hunter/rules/javascript.yaml
new file mode 100644
index 0000000..945a32f
--- /dev/null
+++ b/bug_hunter/rules/javascript.yaml
@@ -0,0 +1,96 @@
+# Pattern rules for JavaScript / TypeScript.
+- id: js-eval
+  pattern: '\beval\s*\('
+  severity: high
+  category: injection
+  title: eval() usage
+  description: eval executes arbitrary code; RCE/XSS if input reaches it.
+  suggestion: Use JSON.parse or a safe alternative.
+
+- id: js-innerhtml
+  pattern: '\.innerHTML\s*='
+  severity: medium
+  category: xss
+  title: innerHTML assignment
+  description: Assigning to innerHTML with unsanitized data is DOM XSS.
+  suggestion: Use textContent or a sanitizer (DOMPurify).
+
+- id: js-document-write
+  pattern: 'document\.write\s*\('
+  severity: medium
+  category: xss
+  title: document.write usage
+  description: document.write with dynamic data enables DOM XSS.
+  suggestion: Use DOM APIs instead.
+
+- id: js-dangerously-set
+  pattern: 'dangerouslySetInnerHTML'
+  severity: medium
+  category: xss
+  title: React dangerouslySetInnerHTML
+  description: Raw HTML injection in React; XSS if the content is user-controlled.
+  suggestion: Sanitize with DOMPurify first.
+
+- id: js-child-process-exec
+  pattern: 'child_process.*\bexec\s*\(|require\(["'']child_process["'']\)\.exec'
+  severity: high
+  category: injection
+  title: child_process.exec
+  description: exec runs a shell; string interpolation is command injection.
+  suggestion: Use execFile/spawn with an argv array.
+
+- id: js-sql-concat
+  pattern: '(query|execute)\s*\(\s*[`"''][^`"'']*(\+|\$\{)'
+  severity: high
+  category: sqli
+  title: SQL built by string concatenation/interpolation
+  description: Interpolated values in SQL are SQL injection.
+  suggestion: Use parameterized queries / prepared statements.
+
+- id: js-hardcoded-secret
+  pattern: '(?i)(api[_-]?key|secret|password|token)\s*[:=]\s*["''][^"'']{8,}["'']'
+  severity: high
+  category: secrets
+  title: Hardcoded credential
+  description: A secret/password/token is hardcoded in source.
+  suggestion: Use environment variables (process.env).
+
+- id: js-jwt-no-verify
+  pattern: 'jwt\.decode\s*\('
+  severity: high
+  category: auth
+  title: jwt.decode used instead of jwt.verify
+  description: "decode() does not validate the signature: token forgery possible."
+  suggestion: Use jwt.verify with the secret/public key.
+
+- id: js-cors-star
+  pattern: '(?i)(Access-Control-Allow-Origin|cors\().*["'']\*["'']'
+  severity: medium
+  category: misconfiguration
+  title: CORS wildcard origin
+  description: "Allow-Origin '*' lets any site read responses from a user's browser."
+  suggestion: Whitelist specific origins.
+
+- id: js-regex-dos
+  pattern: 'new RegExp\s*\([^)]*req\.|new RegExp\s*\([^)]*params'
+  severity: medium
+  category: dos
+  title: Regex built from user input
+  description: User-controlled regex enables ReDoS (catastrophic backtracking).
+  suggestion: Escape user input or use a fixed pattern.
+
+- id: js-proto-pollution
+  pattern: '__proto__\s*\[?\s*=|\.constructor\.prototype\s*='
+  severity: high
+  category: injection
+  title: Prototype pollution
+  description: Assigning to __proto__/constructor.prototype pollutes all objects.
+  suggestion: Use Object.create(null) maps or validate keys.
+
+- id: js-no-csrf-cookie
+  pattern: 'cookie\s*:\s*\{[^}]*sameSite\s*:\s*["'']none["'']'
+  severity: medium
+  category: csrf
+  title: Cookie sameSite=none
+  description: sameSite=none allows cross-site sending — CSRF risk without extra protection.
+  suggestion: Use sameSite 'lax'/'strict' or add CSRF tokens.
