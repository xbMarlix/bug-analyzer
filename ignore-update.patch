diff --git a/tests/test_universal.py b/tests/test_universal.py
index a26fb46..ff1ab00 100644
--- a/tests/test_universal.py
+++ b/tests/test_universal.py
@@ -100,6 +100,43 @@ def test_default_ignored_still_works(tmp_path):
     assert files == []
 
 
+# ---- ignore mechanism ----
+
+def test_inline_ignore_marker():
+    from bug_hunter.ignore import IgnoreRules, apply_ignores
+    bugs = [_bug("a.py", 5, "secrets", "static")]
+    out = apply_ignores(bugs, IgnoreRules(), {"a.py": ["x = 1"] * 4 + ["token = 'abc'  # bug-hunter-ignore"]})
+    assert out == []
+
+
+def test_inline_ignore_named_rule():
+    from bug_hunter.ignore import IgnoreRules, apply_ignores
+    bug = _bug("a.py", 1, "secrets", "static")
+    bug.title = "Hardcoded Secret"
+    kept = apply_ignores([bug], IgnoreRules(), {"a.py": ["t = 'x'  # bug-hunter-ignore: Other Rule"]})
+    assert len(kept) == 1
+
+
+def test_self_exclusion_rules_files():
+    from bug_hunter.ignore import IgnoreRules, apply_ignores
+    bug = _bug("bug_hunter/rules/python.yaml", 3, "secrets", "static")
+    assert apply_ignores([bug], IgnoreRules()) == []
+    bug2 = _bug("bug_hunter/analyzer/static.py", 34, "injection", "static")
+    assert apply_ignores([bug2], IgnoreRules()) == []
+
+
+def test_bughunterignore_file(tmp_path):
+    from bug_hunter.ignore import IgnoreRules, apply_ignores
+    (tmp_path / ".bughunterignore").write_text("vendored/**\nconfig/example.py:Hardcoded Secret\n")
+    ignore = IgnoreRules(tmp_path)
+    b1 = _bug("vendored/lib/x.py", 1, "injection", "static")
+    b2 = _bug("config/example.py", 1, "secrets", "static"); b2.title = "Hardcoded Secret"
+    b3 = _bug("config/example.py", 2, "xss", "static")
+    b4 = _bug("src/main.py", 1, "injection", "static")
+    out = apply_ignores([b1, b2, b3, b4], ignore)
+    assert len(out) == 2 and out[0] is b3 and out[1] is b4
+
+
